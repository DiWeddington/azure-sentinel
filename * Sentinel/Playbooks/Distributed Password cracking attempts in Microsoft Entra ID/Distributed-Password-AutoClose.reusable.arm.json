{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "workflowName": {
      "type": "string",
      "defaultValue": "AutoClose-DistPwdCrack-NoLegacyAuth"
    },
    "location": {
      "type": "string",
      "metadata": {
        "description": "Azure region for the Logic App and managed API connection location."
      }
    },
    "workflowState": {
      "type": "string",
      "defaultValue": "Enabled",
      "allowedValues": [
        "Enabled",
        "Disabled"
      ]
    },
    "sentinelConnectionResourceId": {
      "type": "string",
      "metadata": {
        "description": "Resource ID of an existing Microsoft.Web/connections Microsoft Sentinel API connection."
      }
    },
    "sentinelConnectionName": {
      "type": "string",
      "defaultValue": "azuresentinel"
    },
    "azureMonitorLogsConnectionResourceId": {
      "type": "string",
      "metadata": {
        "description": "Resource ID of an existing Microsoft.Web/connections Azure Monitor Logs API connection."
      }
    },
    "azureMonitorLogsConnectionName": {
      "type": "string",
      "defaultValue": "azuremonitorlogs"
    },
    "targetSubscriptionId": {
      "type": "string"
    },
    "targetResourceGroupName": {
      "type": "string"
    },
    "targetWorkspaceName": {
      "type": "string"
    },
    "queryTimeRange": {
      "type": "string",
      "defaultValue": "Last 7 days"
    },
    "legacyAuthKqlQuery": {
      "type": "string",
      "metadata": {
        "description": "KQL used to detect successful legacy authentication."
      }
    },
    "autoCloseCommentMessage": {
      "type": "string"
    },
    "manualInvestigationCommentMessage": {
      "type": "string"
    },
    "closeClassificationReasonText": {
      "type": "string",
      "defaultValue": "Auto-closed: No successful legacy authentication detected during password spray attempt"
    }
  },
  "variables": {},
  "resources": [
    {
      "type": "Microsoft.Logic/workflows",
      "apiVersion": "2017-07-01",
      "name": "[parameters('workflowName')]",
      "location": "[parameters('location')]",
      "tags": {
        "azn_m_runsfailedrate": "default@10",
        "azn_m_triggersfailed": "default@0"
      },
      "identity": {
        "type": "SystemAssigned"
      },
      "properties": {
        "state": "[parameters('workflowState')]",
        "definition": {
          "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "$connections": {
              "defaultValue": {},
              "type": "Object"
            },
            "LegacyAuthKqlQuery": {
              "type": "String"
            },
            "TargetSubscriptionId": {
              "type": "String"
            },
            "TargetResourceGroupName": {
              "type": "String"
            },
            "TargetWorkspaceName": {
              "type": "String"
            },
            "QueryTimeRange": {
              "type": "String"
            },
            "AutoCloseCommentMessage": {
              "type": "String"
            },
            "ManualInvestigationCommentMessage": {
              "type": "String"
            },
            "CloseClassificationReasonText": {
              "type": "String"
            }
          },
          "triggers": {
            "Microsoft_Sentinel_incident": {
              "type": "ApiConnectionWebhook",
              "inputs": {
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['azuresentinel']['connectionId']"
                  }
                },
                "body": {
                  "callback_url": "@{listCallbackUrl()}"
                },
                "path": "/incident-creation"
              }
            }
          },
          "actions": {
            "Check_Legacy_Auth": {
              "runAfter": {},
              "type": "ApiConnection",
              "inputs": {
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['azuremonitorlogs']['connectionId']"
                  }
                },
                "method": "post",
                "body": "@parameters('LegacyAuthKqlQuery')",
                "path": "/queryData",
                "queries": {
                  "subscriptions": "@parameters('TargetSubscriptionId')",
                  "resourcegroups": "@parameters('TargetResourceGroupName')",
                  "resourcetype": "Log Analytics Workspace",
                  "resourcename": "@parameters('TargetWorkspaceName')",
                  "timerange": "@parameters('QueryTimeRange')"
                }
              }
            },
            "Condition": {
              "actions": {
                "Add_comment_to_incident_(V3)": {
                  "type": "ApiConnection",
                  "inputs": {
                    "host": {
                      "connection": {
                        "name": "@parameters('$connections')['azuresentinel']['connectionId']"
                      }
                    },
                    "method": "post",
                    "body": {
                      "incidentArmId": "@triggerBody()?['object']?['id']",
                      "message": "@parameters('AutoCloseCommentMessage')"
                    },
                    "path": "/Incidents/Comment"
                  }
                },
                "Update_incident": {
                  "runAfter": {
                    "Add_comment_to_incident_(V3)": [
                      "Succeeded"
                    ]
                  },
                  "type": "ApiConnection",
                  "inputs": {
                    "host": {
                      "connection": {
                        "name": "@parameters('$connections')['azuresentinel']['connectionId']"
                      }
                    },
                    "method": "put",
                    "body": {
                      "incidentArmId": "@triggerBody()?['object']?['id']",
                      "status": "Closed",
                      "classification": {
                        "ClassificationAndReason": "BenignPositive - SuspiciousButExpected",
                        "ClassificationReasonText": "@parameters('CloseClassificationReasonText')"
                      }
                    },
                    "path": "/Incidents"
                  }
                }
              },
              "runAfter": {
                "Check_Legacy_Auth": [
                  "Succeeded"
                ]
              },
              "else": {
                "actions": {
                  "Add_comment_to_incident_(V3)_1": {
                    "type": "ApiConnection",
                    "inputs": {
                      "host": {
                        "connection": {
                          "name": "@parameters('$connections')['azuresentinel']['connectionId']"
                        }
                      },
                      "method": "post",
                      "body": {
                        "incidentArmId": "@triggerBody()?['object']?['id']",
                        "message": "@parameters('ManualInvestigationCommentMessage')"
                      },
                      "path": "/Incidents/Comment"
                    }
                  }
                }
              },
              "expression": {
                "and": [
                  {
                    "equals": [
                      "@empty(body('Check_Legacy_Auth')?['value'])",
                      "@true"
                    ]
                  }
                ]
              },
              "type": "If"
            }
          },
          "outputs": {}
        },
        "parameters": {
          "$connections": {
            "value": {
              "azuresentinel": {
                "id": "[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Web/locations/', parameters('location'), '/managedApis/azuresentinel')]",
                "connectionId": "[parameters('sentinelConnectionResourceId')]",
                "connectionName": "[parameters('sentinelConnectionName')]",
                "connectionProperties": {
                  "authentication": {
                    "type": "ManagedServiceIdentity"
                  }
                }
              },
              "azuremonitorlogs": {
                "id": "[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Web/locations/', parameters('location'), '/managedApis/azuremonitorlogs')]",
                "connectionId": "[parameters('azureMonitorLogsConnectionResourceId')]",
                "connectionName": "[parameters('azureMonitorLogsConnectionName')]",
                "connectionProperties": {
                  "authentication": {
                    "type": "ManagedServiceIdentity"
                  }
                }
              }
            }
          },
          "LegacyAuthKqlQuery": {
            "value": "[parameters('legacyAuthKqlQuery')]"
          },
          "TargetSubscriptionId": {
            "value": "[parameters('targetSubscriptionId')]"
          },
          "TargetResourceGroupName": {
            "value": "[parameters('targetResourceGroupName')]"
          },
          "TargetWorkspaceName": {
            "value": "[parameters('targetWorkspaceName')]"
          },
          "QueryTimeRange": {
            "value": "[parameters('queryTimeRange')]"
          },
          "AutoCloseCommentMessage": {
            "value": "[parameters('autoCloseCommentMessage')]"
          },
          "ManualInvestigationCommentMessage": {
            "value": "[parameters('manualInvestigationCommentMessage')]"
          },
          "CloseClassificationReasonText": {
            "value": "[parameters('closeClassificationReasonText')]"
          }
        }
      }
    }
  ]
}